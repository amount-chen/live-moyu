{
  "manifest_version": 3,
  "name": "直播摸鱼 · 悬浮输入连接器",
  "version": "0.2.0",
  "description": "连接 Windows 悬浮输入框与用户绑定的 B 站直播标签页。",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://live.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "绑定直播间",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "response.js",
        "observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
