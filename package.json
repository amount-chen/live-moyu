{
  "name": "live-moyu",
  "version": "0.2.3",
  "private": true,
  "description": "Windows floating input for Bilibili live chat",
  "author": "Live Moyu",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "native": "node scripts/build-native.cjs",
    "start": "electron .",
    "icons": "node scripts/make-icon.cjs",
    "dist": "npm run icons && npm run native && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.livemoyu.desktop",
    "productName": "LiveMoyu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native"
      },
      {
        "from": "full-extension",
        "to": "extension"
      },
      {
        "from": "使用说明.md",
        "to": "使用说明.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "desktop/app.ico"
    },
    "nsis": {
      "installerIcon": "desktop/app.ico",
      "uninstallerIcon": "desktop/app.ico",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/installer.nsh",
      "shortcutName": "直播摸鱼",
      "artifactName": "LiveMoyu-Setup-${version}.${ext}"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amount-chen/live-moyu.git"
  },
  "homepage": "https://github.com/amount-chen/live-moyu#readme",
  "bugs": {
    "url": "https://github.com/amount-chen/live-moyu/issues"
  }
}
